<Page x:Class="WpfApplication2.Views.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"  
      xmlns:local="clr-namespace:WpfApplication2.Views"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="800"
      Title="Dashboard">

    <Grid Background="Beige">

        <Button x:Name="ExitButoon" Height="70" Width="200" Background="Transparent" HorizontalContentAlignment="Left" Foreground="Blue" FontSize="30" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderThickness="2" Click="ExitButoon_Click" Margin="502,236,98,94"  >
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Logout" Width="30" Height="50"/>
                <TextBlock VerticalAlignment="center" FontSize="14" Margin="10,0,0,0">Quitter</TextBlock>
            </StackPanel>
        </Button>
        <Button x:Name="btnLZ" Height="70" Width="200" Background="Transparent" HorizontalContentAlignment="Left" Foreground="Blue" FontSize="30" HorizontalAlignment="Stretch" BorderThickness="2" Click="btnLZ_Click" Margin="251,20,349,310"  >
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Factory" Width="30" Height="50"/>
                <TextBlock VerticalAlignment="center" FontSize="14" Margin="10,0,0,0">Zone Industrielle</TextBlock>
            </StackPanel>
        </Button>

        <Button x:Name="btnLT" Click="btnLT_Click" Height="70" Width="200" Background="Transparent" HorizontalContentAlignment="Left" Foreground="Blue" FontSize="30" HorizontalAlignment="Stretch" BorderThickness="2" Margin="251,120,349,210"   >
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Terrain" Width="30" Height="50" />
                <TextBlock VerticalAlignment="center" FontSize="14" Margin="10,0,0,0">Lots</TextBlock>
            </StackPanel>
        </Button>

        <Button x:Name="btnInvst" Click="btnInvst_Click" Height="70" Width="200" Background="Transparent" HorizontalContentAlignment="Left" Foreground="Blue" FontSize="30" HorizontalAlignment="Stretch" BorderThickness="2" Margin="502,20,98,310"  >
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AccountGroup" Width="30" Height="60" />
                <TextBlock VerticalAlignment="center" FontSize="14" Margin="10,0,0,0">Investisseurs</TextBlock>
            </StackPanel>
        </Button>

        <Button x:Name="btnAttrib" Click="btnAttrib_Click" Height="70"  Width="200" Background="Transparent" HorizontalContentAlignment="Left" Foreground="Blue" FontSize="30" HorizontalAlignment="Stretch" BorderThickness="2" Margin="502,120,98,210">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Label" Width="30" Height="60" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Margin="10,0,0,0">Attributions</TextBlock>
                    </StackPanel>
                </Button>

        <Button  Height="70" Width="200" Background="Transparent" HorizontalContentAlignment="Left" Foreground="Blue" FontSize="30" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderThickness="2" Margin="251,236,349,94" >
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Cog" Width="30" Height="60" />
                <TextBlock VerticalAlignment="Center" FontSize="14" Margin="10,0,0,0">Paramétres</TextBlock>
            </StackPanel>
        </Button>






    </Grid>
</Page>
