<Page x:Class="WpfApplication2.Views.Lots.AddLots"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApplication2.Views.Lots"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="800"
      Title="AddLots">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="70*" />

            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>








        <Grid Grid.Row="0" Grid.Column="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <StackPanel Orientation="Vertical" Margin="-10,0,10,0">

                    

                    <StackPanel Height="30" Orientation="Horizontal" Margin="0 20 0 0" >
                        <TextBlock Text="Nom de Zone :" FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <ComboBox  x:Name="IdZone" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" SelectionChanged="IdZone_SelectionChanged" />
                    </StackPanel>

                    

                    <StackPanel Height="30" Orientation="Horizontal" Margin="0 30 0 0">
                        <TextBlock Text="Numéro Lot :" FontSize="15" Width="150" Height="30" Margin="20 0 0 0" />
                        <TextBox x:Name="NumLot"  BorderThickness="1" Width="200" Height="30" Margin="0,0,0,0.4"  />
                    </StackPanel>

                    
                </StackPanel>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1">

                <StackPanel>

                    


                    

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Ilot :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="Ilot" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Surface:"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="Surface" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>
                </StackPanel>
            </Grid>








        </Grid>

        <Grid Grid.Row="1" Grid.Column="0">
            <Button x:Name="AjouterLot" Click="AjouterLot_Click" HorizontalAlignment="Left" Height="35" Width="100" Content="Ajouter" FontSize="14" VerticalAlignment="Center" Margin="180,0,0,0"   ></Button>
            <Button x:Name="SupprimerLot" Click="SupprimerLot_Click" Height="35" Width="100" Content="Supprimer" FontSize="14" HorizontalAlignment="Right" Margin="0,0,180,0"  ></Button>
            <Button x:Name="ModifierLot" Click="ModifierLot_Click"  Height="35" Width="100" Content="Modifier" FontSize="14" HorizontalAlignment="Center"  ></Button>
        </Grid>
    </Grid>
</Page>
