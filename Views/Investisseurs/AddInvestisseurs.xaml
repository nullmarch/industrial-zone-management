<Page x:Class="WpfApplication2.Views.Investisseurs.AddInvestisseurs"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApplication2.Views.Investisseurs"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="AddInvestisseurs">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="90*" />

            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>







        <Grid Grid.Row="0" Grid.Column="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="0">
                <StackPanel Orientation="Vertical">


                    <StackPanel Height="30" Orientation="Horizontal" Margin="0 30 0 0">
                        <TextBlock Text="Id Investisseur  :" FontSize="15" Width="150" Height="30" Margin="20 0 0 0" />
                        <TextBox x:Name="IdInvestisseur" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal" Margin="0 30 0 0">
                        <TextBlock Text="Raison Sociale :" FontSize="15" Width="150" Height="30" Margin="20 0 0 0" />
                        <TextBox x:Name="RaisonSociale" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>


                    <StackPanel Height="30" Orientation="Horizontal" Margin="0 20 0 0" >
                        <TextBlock Text="Nom Societe :" FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="NomSciete" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Statut :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="Statut" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Numero RC :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="NumRC" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Date RC :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <DatePicker x:Name="DateRC" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="NIF :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="NIF" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="NIS :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="NIS" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Nom Gerant :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="NomGerant" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>




                </StackPanel>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1">
                <StackPanel Orientation="Vertical" Margin="10,-10,-10,10">
                
                

                <StackPanel Height="30" Orientation="Horizontal"  Margin="0 30 0 0">
                    <TextBlock Text="Date de Naissance :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                    <DatePicker x:Name="DateNaissance" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Numéro CNI :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="NumCNI"  BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Date CNI :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <DatePicker x:Name="DateCNI"  BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Adresse :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="Adresse" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Numéro Telephone :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="NumTel" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Numéro Mobile :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="NumMob" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Numéro Fax :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="NumFax" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>

                    <StackPanel Height="30" Orientation="Horizontal"  Margin="0 20 0 0">
                        <TextBlock Text="Email :"  FontSize="15" Width="150" Height="30"  Margin="20 0 0 0"/>
                        <TextBox x:Name="Email" BorderThickness="1" Width="200" Height="30" Margin="0 0 0 0" />
                    </StackPanel>







                </StackPanel>
            </Grid>








        </Grid>

        <Grid Grid.Row="1" Grid.Column="0">
            <Button x:Name="BtnAjtInv" Click="BtnAjtInv_Click" HorizontalAlignment="Left" Height="35" Width="100" Content="Ajouter" FontSize="14" VerticalAlignment="Center" Margin="180,0,0,0"   ></Button>
            <Button x:Name="BtnModInv" Click="BtnSuppInv_Click" Height="35" Width="100" Content="Supprimer" FontSize="14" HorizontalAlignment="Right" Margin="0,0,180,0"  ></Button>
            <Button x:Name="BtnSuppInv" Click="BtnModInv_Click" Height="35" Width="100" Content="Modifier" FontSize="14" HorizontalAlignment="Center"  ></Button>
        </Grid>
    </Grid>
</Page>
